#include <windows.h>

#define IDI_MOUNERU 101

IDI_MOUNERU ICON "mouneru.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION MOUNERU_VERSION_MAJOR,MOUNERU_VERSION_MINOR,MOUNERU_VERSION_PATCH,0
PRODUCTVERSION MOUNERU_VERSION_MAJOR,MOUNERU_VERSION_MINOR,MOUNERU_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MouNeru"
      VALUE "FileDescription", "MouNeru Sleep and Shutdown Timer"
      VALUE "FileVersion", MOUNERU_VERSION_STRING
      VALUE "InternalName", "MouNeru"
      VALUE "OriginalFilename", "MouNeru.exe"
      VALUE "ProductName", "MouNeru"
      VALUE "ProductVersion", MOUNERU_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
